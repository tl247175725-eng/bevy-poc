#!/bin/bash
# ============================================================
# Pre-push: push 前强制检查
# 1. 最多改 2 个 .rs 文件
# 2. 铁律强制检查
# 3. cargo test 全 PASS
# ============================================================
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── 1. 文件数 ──
CHANGED=$(git diff --cached --name-only --diff-filter=M 2>/dev/null | { grep "\.rs$" 2>/dev/null || true; } | wc -l)
NEW=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | { grep "\.rs$" 2>/dev/null || true; } | wc -l)
CHANGED="${CHANGED// /}"
NEW="${NEW// /}"
TOTAL=$((CHANGED + NEW))

if [ "$TOTAL" -gt 2 ]; then
    echo "❌ 一次改了 $TOTAL 个 .rs 文件，最多允许 2 个"
    echo "   请拆成小 commit，每个只改 1-2 个文件"
    echo "   git reset HEAD~1 → 分批 add → 分批 commit"
    exit 1
fi
echo "✅ 文件数检查通过 ($TOTAL 个 .rs)"

# ── 2. 铁律检查 ──
bash "$SCRIPT_DIR/../scripts/check-iron-law.sh"

# ── 3. cargo test（用 trap 保证失败时 exit 1） ──
echo ""
echo "🧪 cargo test..."
if ! cargo test; then
    echo ""
    echo "❌ cargo test 失败 —— push 被拒"
    exit 1
fi

echo ""
echo "✅ Pre-push 全部通过"
